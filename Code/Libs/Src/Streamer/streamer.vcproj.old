				TypeLibraryName=".\Release/streamer.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="..\copy_release_explicit.bat"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="NDEBUG,BUILD_LEVEL=\&quot;Release\&quot;"
				Culture="1033"
				AdditionalIncludeDirectories="..\"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
