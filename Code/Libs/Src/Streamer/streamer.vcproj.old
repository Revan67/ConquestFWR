				ProgramDataBaseFileName=".\Release/"
				WarningLevel="3"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="DACOM.lib COMHeap.lib msacm32.lib"
				OutputFile=".\Release/streamer.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile=".\Release/streamer.pdb"
				GenerateMapFile="TRUE"
				MapFileName=".\Release/streamer.map"
				SubSystem="2"
				EntryPointSymbol="DllMain"
				ImportLibrary=".\Release/streamer.lib"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="NDEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
