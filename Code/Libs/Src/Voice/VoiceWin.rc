//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\VoiceWin.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_VOICEWIN_DIALOG DIALOGEX 0, 0, 219, 159
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "VoiceWin"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "Initiate Connection",IDC_INITIATE,61,103,124,14
    EDITTEXT        IDC_LOCALHOST,61,18,151,14,ES_AUTOHSCROLL
    LTEXT           "Host Name:",IDC_STATIC,13,21,38,8
    GROUPBOX        "Remote Host",IDC_STATIC,7,59,205,93
    PUSHBUTTON      "Break Connection",IDC_BREAK,61,118,124,14
    EDITTEXT        IDC_LOCALPORT,61,35,38,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Host Port:",IDC_STATIC,13,38,32,8
    GROUPBOX        "Local Host",IDC_STATIC,7,7,205,49
    EDITTEXT        IDC_REMOTEHOST,61,68,151,14,ES_AUTOHSCROLL
    LTEXT           "Host Name:",IDC_STATIC,13,71,38,8
    EDITTEXT        IDC_REMOTEPORT,61,86,38,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Host Port:",IDC_STATIC,13,89,32,8
    EDITTEXT        IDC_MESSAGEBAR,7,138,205,14,ES_AUTOHSCROLL | ES_READONLY
END


