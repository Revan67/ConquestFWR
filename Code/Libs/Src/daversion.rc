//
// Standard DA library component version resource script.
//
#ifdef APSTUDIO_INVOKED
#error You cannot edit this with DevStudio because it is too stupid to handle macro substitution.
#endif

// NOTE: The component must define the following macros
// COMP_MAJOR
// COMP_MINOR

// Include the library wide definitions
#include <libver.h>

// Include build specific definitions
#include <buildres.h>

//
// Define defaults for symbols defined on the resource compiler command line, in case
// this file is built by means other than the official build process.
//

// If the BUILD_LEVEL has not been defined, infer it from the NDEBUG and
// _DEBUG settings. This means that you only need to define BUILD_LEVEL for
// development versions.

#ifndef BUILD_LEVEL
        #ifdef NDEBUG
                #define BUILD_LEVEL "Release"
        #else
                #ifdef _DEBUG
                        #define BUILD_LEVEL "Debug"
                #else
                        #define BUILD_LEVEL "Unlabelled Build"
                #endif
        #endif
#endif

// If the OFFICIAL_BUILD has not been defined already, define it to indicate that
// this is an unofficial build.  Official builds define this macro as "" or "Official "

#ifndef OFFICIAL_BUILD
#define OFFICIAL_BUILD "Unofficial "
#endif

#define APSTUDIO_READONLY_SYMBOLS
/////////////////////////////////////////////////////////////////////////////
//
// Generated from the TEXTINCLUDE 2 resource.
//
#include "afxres.h"

/////////////////////////////////////////////////////////////////////////////
#undef APSTUDIO_READONLY_SYMBOLS

/////////////////////////////////////////////////////////////////////////////
// English (U.S.) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
#ifdef _WIN32
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)
#endif //_WIN32

#ifndef _MAC
/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION COMP_MAJOR,0,0,COMP_MINOR
 PRODUCTVERSION LIB_MAJOR,LIB_MINOR,0,LIB_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", OFFICIAL_BUILD BUILD_LEVEL 
            VALUE "CompanyName", "Digital Anvil\0"
            VALUE "FileDescription", COMP_DESC "\0"
            VALUE "FileVersion", COMP_VER_STRING
            VALUE "InternalName", COMP_NAME "\0"
            VALUE "LegalCopyright", "Copyright © 1998,1999\0"
            VALUE "OriginalFilename", COMP_NAME ".dll\0"
            VALUE "ProductName", "Digital Anvil Component Library\0"
            VALUE "ProductVersion", LIB_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#endif    // !_MAC


#ifdef APSTUDIO_INVOKED
/////////////////////////////////////////////////////////////////////////////
//
// TEXTINCLUDE
//

1 TEXTINCLUDE DISCARDABLE 
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE DISCARDABLE 
BEGIN
    "#include ""afxres.h""\r\n"
    "\0"
END

3 TEXTINCLUDE DISCARDABLE 
BEGIN
    "\r\n"
    "\0"
END

#endif    // APSTUDIO_INVOKED

#endif    // English (U.S.) resources
