//
// Menu
//

IDR_SCENE_VIEW_POPUP_MENU MENU DISCARDABLE 
BEGIN
    POPUP "SceneView"
    BEGIN
        MENUITEM "&Mesh",                       ID_SCENE_VIEW_MESH
        MENUITEM "&Axes",                       ID_SCENE_VIEW_AXES
        MENUITEM SEPARATOR
        MENUITEM "Associate &Camera",           ID_SCENE_VIEW_SELECT_CAMERA
        MENUITEM SEPARATOR
        MENUITEM "&XY Plane",                   ID_SCENEVIEW_XY_PLANE
        MENUITEM "&YZ Plane",                   ID_SCENEVIEW_YZ_PLANE
        MENUITEM "&ZX Plane",                   ID_SCENEVIEW_ZX_PLANE
        MENUITEM SEPARATOR
        MENUITEM "&Textured",                   ID_SCENE_VIEW_RENDER_TEXTURED

        MENUITEM "&Show Letterbox",             ID_SCENEVIEW_SHOWLETTERBOX
    END
    POPUP "SceneEntity"
    BEGIN
        MENUITEM "&XY Plane",                   ID_SCENEVIEW_SELECTION_XY_PLANE

        MENUITEM "&YZ Plane",                   ID_SCENEVIEW_SELECTION_YZ_PLANE

        MENUITEM "&ZX Plane",                   ID_SCENEVIEW_SELECTION_ZX_PLANE

        MENUITEM SEPARATOR
        MENUITEM "Show &Motion Path",           ID_SCENE_ENTITY_SHOW_MOTION_PATH

        MENUITEM SEPARATOR
        MENUITEM "&Properties...",              ID_SCENE_ENTITY_PROPERTIES
    END
    POPUP "Compound"
    BEGIN
        MENUITEM "&Start Motion",               ID_DEFORMABLE_ENTITY_START_MOTION

        MENUITEM "&Loop Motion",                ID_DEFORMABLE_ENTITY_LOOP_MOTION

        MENUITEM "P&ause Motion",               ID_DEFORMABLE_ENTITY_PAUSE_MOTION

        MENUITEM "&Resume Motion",              ID_DEFORMABLE_ENTITY_RESUME_MOTION

        MENUITEM "S&top Motion",                ID_DEFORMABLE_ENTITY_STOP_MOTION

        MENUITEM SEPARATOR
        MENUITEM "Pla&y Sound...",              ID_COMPOUND_ENTITY_PLAY_SOUND

        MENUITEM SEPARATOR
        MENUITEM "Show &Hardpoints",            ID_COMPOUND_ENTITY_SHOW_HARDPOINTS

        MENUITEM SEPARATOR
        MENUITEM "&Remember Hardpoint",         ID_COMPOUND_ENTITY_COPY_HARDPOINT_POSITION

        MENUITEM SEPARATOR
        MENUITEM "&Move To Remembered Hardpoint", 
                                                ID_COMPOUND_ENTITY_PASTE_POSITION

        MENUITEM SEPARATOR
        MENUITEM "&Make Child Of Remembered Hardpoint", 
                                                ID_COMPOUND_ENTITY_MAKE_CHILD

        MENUITEM SEPARATOR
        MENUITEM "Set &View Position",          ID_COMPOUND_ENTITY_SET_CAMERA

        MENUITEM SEPARATOR
        MENUITEM "&XY Plane",                   ID_SCENEVIEW_SELECTION_XY_PLANE

        MENUITEM "&YZ Plane",                   ID_SCENEVIEW_SELECTION_YZ_PLANE

        MENUITEM "&ZX Plane",                   ID_SCENEVIEW_SELECTION_ZX_PLANE

        MENUITEM SEPARATOR
        MENUITEM "Show &Motion Path",           ID_COMPOUND_ENTITY_SHOW_MOTION_PATH

        MENUITEM SEPARATOR
        MENUITEM "&Properties...",              ID_COMPOUND_ENTITY_PROPERTIES

    END
    POPUP "Deformable"
    BEGIN
        MENUITEM "&Start Motion",               ID_DEFORMABLE_ENTITY_START_MOTION

        MENUITEM "&Loop Motion",                ID_DEFORMABLE_ENTITY_LOOP_MOTION

        MENUITEM "P&ause Motion",               ID_DEFORMABLE_ENTITY_PAUSE_MOTION

        MENUITEM "&Resume Motion",              ID_DEFORMABLE_ENTITY_RESUME_MOTION

        MENUITEM "S&top Motion",                ID_DEFORMABLE_ENTITY_STOP_MOTION

        MENUITEM SEPARATOR
        MENUITEM "Pla&y Sound...",              ID_DEFORMABLE_ENTITY_PLAY_SOUND

        MENUITEM SEPARATOR
        MENUITEM "Show &Hardpoints",            ID_DEFORMABLE_ENTITY_SHOW_HARDPOINTS

        MENUITEM "Show Skeleton",               ID_DEFORMABLE_ENTITY_SHOW_SKELETON

        MENUITEM SEPARATOR
        MENUITEM "&Remember Hardpoint",         ID_DEFORMABLE_ENTITY_COPY_HARDPOINT_POSITION

        MENUITEM SEPARATOR
        MENUITEM "&Move To Remembered Hardpoint", 
                                                ID_DEFORMABLE_ENTITY_PASTE_POSITION

        MENUITEM SEPARATOR
        MENUITEM "&Make Child Of Remembered Hardpoint", 
                                                ID_DEFORMABLE_ENTITY_MAKE_CHILD

        MENUITEM SEPARATOR
        MENUITEM "&XY Plane",                   ID_SCENEVIEW_SELECTION_XY_PLANE

        MENUITEM "&YZ Plane",                   ID_SCENEVIEW_SELECTION_YZ_PLANE

        MENUITEM "&ZX Plane",                   ID_SCENEVIEW_SELECTION_ZX_PLANE

        MENUITEM SEPARATOR
        MENUITEM "&Properties...",              ID_DEFORMABLE_ENTITY_PROPERTIES

    END
    POPUP "Position Marker"
    BEGIN
        MENUITEM "&XY Plane",                   ID_SCENEVIEW_SELECTION_XY_PLANE

        MENUITEM "&YZ Plane",                   ID_SCENEVIEW_SELECTION_YZ_PLANE

        MENUITEM "&ZX Plane",                   ID_SCENEVIEW_SELECTION_ZX_PLANE

        MENUITEM SEPARATOR
        MENUITEM "Pla&y Sound...",              ID_POSITION_MARKER_ENTITY_PLAY_SOUND

        MENUITEM SEPARATOR
        MENUITEM "Show &Motion Path",           ID_SCENE_ENTITY_SHOW_MOTION_PATH

        MENUITEM SEPARATOR
        MENUITEM "&Properties...",              ID_SCENE_ENTITY_PROPERTIES
    END
END

IDR_TRACK_VIEW_POPUP_MENU MENU DISCARDABLE 
BEGIN
    POPUP "Marker"
    BEGIN
        MENUITEM "&Delete",                     ID_TRACK_VIEW_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Set Scene Time to Marker",   ID_TRACK_VIEW_SET_SCENE_TIME_TO_MARKER_TIME

        MENUITEM SEPARATOR
        MENUITEM "&Properties...",              ID_TRACK_VIEW_PROPERTIES
    END
    POPUP "Live Camera Track"
    BEGIN
        MENUITEM "Switch To &Camera",           ID_TRACK_VIEW_SELECT_LIVE_CAMERA

    END
    POPUP "Track Context Menu"
    BEGIN
        MENUITEM "&Add Marker At Current Time", ID_TRACK_VIEW_ADD_MARKER_AT_CURRENT_TIME

    END
END

IDR_SCENE_PALETTE_POPUP_MENU MENU DISCARDABLE 
BEGIN
