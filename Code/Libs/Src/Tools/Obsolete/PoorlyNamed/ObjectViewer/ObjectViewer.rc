IDR_APPLICATION_MENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        POPUP "&New"
        BEGIN
            MENUITEM "&Scene Window",               ID_FILE_NEW_SCENEWINDOW
            MENUITEM "&DirectShow Window",          ID_FILE_NEW_DIRECTSHOWWINDOW

            MENUITEM "&Texture Viewer",             ID_FILE_NEW_TEXTUREVIEWER

            MENUITEM "&Other...",                   ID_FILE_NEW_OTHER
        END
        MENUITEM SEPARATOR
        MENUITEM "&Device...",                  ID_FILE_DEVICE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&System"
    BEGIN
        MENUITEM "&Profile Logging",            ID_SYSTEM_RENDERPIPELINE_PROFILELOGGING

    END
END


