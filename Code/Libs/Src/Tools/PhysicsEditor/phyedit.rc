IDR_PE_MENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Load",                       IDD_FILE_OPEN
        MENUITEM "&Save",                       IDD_FILE_SAVE
        MENUITEM "Save &As",                    IDD_FILE_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "Copy/export",                 IDD_FILE_COPY
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDD_FILE_EXIT
    END
    POPUP "&Editing"
    BEGIN
        POPUP "Mirror extents"
        BEGIN
            MENUITEM "X Axis",                      ID_MIRROR_X
            MENUITEM "Y axis",                      ID_MIRROR_Y
        END
        MENUITEM "Rigid data (mass/inertia)",   ID_EDIT_RIGID_DATA
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Solid extents",              ID_VIEW_SOLIDEXTENTS
        MENUITEM "Collidable only",             ID_VIEW_COLLIDABLE_ONLY
        MENUITEM "Textures",                    ID_VIEW_TEXTURES
    END
    POPUP "&Speed tests"
    BEGIN
        MENUITEM "Rays (center-directed)",      ID_CENTER_RAYS
    END
    POPUP "Visuali&zation"
    BEGIN
        MENUITEM "Ray collisions",              ID_VISUALIZE_RAYS
    END
    POPUP "&Generate"
    BEGIN
        MENUITEM "Sphere",                      ID_GENERATE_SPHERE
        MENUITEM "Sphere -> Box",               ID_GENERATE_SPHERE_BOX
        MENUITEM SEPARATOR
        MENUITEM "Inertia tensor",              ID_GENERATE_IBODY
    END
END


