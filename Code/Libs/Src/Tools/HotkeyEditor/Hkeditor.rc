/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU1 MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New...",                     IDM_NEW
        MENUITEM "&Open...",                    IDM_OPEN
        MENUITEM "&Close",                      IDM_CLOSE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Save",                       IDM_SAVE, GRAYED
        MENUITEM "Save &As...",                 IDM_SAVEAS, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Edit", GRAYED
    BEGIN
        MENUITEM "&Undo\tCtrl-Z",               IDM_UNDO, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Modify",                     IDM_MODIFY
        MENUITEM "&Insert",                     IDM_INSERT
        MENUITEM "&Delete",                     IDM_DELETE
    END
    POPUP "&Preferences"
    BEGIN
        MENUITEM "&On Top",                     IDM_ALWAYS_ON_TOP
        MENUITEM "Generate &Text (*.txt) File", IDM_WRITE_TEXT
        MENUITEM "Generate C &Header File",     IDM_WRITE_HEADER
    END
    MENUITEM "&Test",                       IDM_TEST, GRAYED
END


