//Version Stamping information.
#ifndef _MAC
/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION STAMPER_NUM_FILE_VERSION
 PRODUCTVERSION STAMPER_NUM_PROD_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Setup/Uninstaller/Autorun utility for Microsoft Asheron's Call\0"
            VALUE "CompanyName", "Microsoft Corporation\0"
            VALUE "FileDescription", "Microsoft Asheron's Call Setup\0"
            VALUE "FileVersion", STAMPER_STR_FILE_VERSION
            VALUE "InternalName", "Setup\0"
            VALUE "LegalCopyright", "© 1997 Microsoft Corp.\0"
            VALUE "LegalTrademarks", "© Microsoft Corp.\0"
            VALUE "OriginalFilename", "Setup.exe\0"
            VALUE "PrivateBuild", "\0"
            VALUE "ProductName", "Microsoft Asheron's Call Setup\0"
            VALUE "ProductVersion", STAMPER_STR_PROD_VERSION
            VALUE "SpecialBuild", "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#endif    // !_MAC


