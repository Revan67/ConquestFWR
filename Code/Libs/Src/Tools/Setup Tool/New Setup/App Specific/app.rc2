//Version Stamping information.
#ifndef _MAC
/////////////////////////////////////////////////////////////////////////////
//
// Version
//


VS_VERSION_INFO VERSIONINFO
 FILEVERSION STAMPER_NUM_FILE_VERSION
 PRODUCTVERSION STAMPER_NUM_PROD_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "AutoRun/Setup Resources for Conquest: Frontier Wars\0"
            VALUE "CompanyName", "Digital Anvil\0"
            VALUE "FileDescription", "Digital Anvil's Conquest AutoRun/Setup Resources\0"
            VALUE "FileVersion", STAMPER_STR_FILE_VERSION
            VALUE "InternalName", "SetupENU.Dll\0"
            VALUE "LegalCopyright", "© 1999 Digital Anvil Inc.\0"
            VALUE "LegalTrademarks", "© Digital Anvil Inc.\0"
            VALUE "OriginalFilename", "SetupENU.Dll\0"
            VALUE "PrivateBuild", "\0"
            VALUE "ProductName", "Digital Anvil's Conquest\0"
            VALUE "ProductVersion", STAMPER_STR_PROD_VERSION
            VALUE "SpecialBuild", "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
#endif    // !_MAC

