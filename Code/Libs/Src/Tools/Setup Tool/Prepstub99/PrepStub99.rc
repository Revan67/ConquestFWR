IDM_MENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New",                        IDM_NEW, GRAYED
        MENUITEM "&Open...",                    IDM_LOADSCRIPT
        MENUITEM "&Close",                      IDM_CLOSE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Save",                       IDM_SAVE, GRAYED
        MENUITEM "Save &As...",                 IDM_SAVEAS, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Recent &Files",               IDM_RECENTFILES
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Cu&t",                        ID_EDIT_CUT, GRAYED
        MENUITEM "&Copy",                       ID_EDIT_COPY, GRAYED
        MENUITEM "Paste",                       ID_EDIT_PASTE, GRAYED
        MENUITEM "Delete",                      ID_POPUP_DELETE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Select Al&l",                 ID_EDIT_SELECTALL, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Command &Properties...",      ID_POPUP_PROPERTIES, GRAYED
    END
    POPUP "&Build"
    BEGIN
        MENUITEM "&Update File List...",        IDM_UPDATEFILELIST, GRAYED
        MENUITEM "&Inject Setup...",            IDM_INJECT, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Replicate, and Inject. (ISO Compliant)...", IDM_BUILD
        , GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Build Trial Version...",      IDM_BUILD_TRIAL, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Settings...",                IDM_BUILDSETTINGS, GRAYED
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Regular Commands",           IDM_SHOWREG, CHECKED
        MENUITEM "&Internal Commands",          IDM_SHOWINT, CHECKED
        MENUITEM "&Comments",                   IDM_SHOWCOM, CHECKED
        MENUITEM "Show Internal &Properties",   IDM_SHOWPROPERTY
        MENUITEM SEPARATOR
        MENUITEM "Show Items in &Color",        IDM_SHOWCOLOR, CHECKED
        MENUITEM "Options...",                  ID_VIEW_OPTIONS, GRAYED
    END
    POPUP "&Advanced"
    BEGIN
        MENUITEM "&Load Strings from Resource DLL", IDM_LOADSTRINGS, GRAYED
        MENUITEM "&Save Static Strings to 'StaticStrings.rc'", IDM_SAVERC3
        , GRAYED
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                   IDM_ABOUT
    END
END

IDM_COMMAND_ITEM_MENU MENU DISCARDABLE 
