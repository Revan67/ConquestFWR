/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE DISCARDABLE 
BEGIN
    ID_PTE_LOAD             "Loads particle event into current slot"
    ID_PTE_SAVE             "Saves current particle event"
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDC_BOUNDING_RADIUS     "This value defines the maximum size for the entire particle \nsystem.  For example, the bounding radius is used when culling \nthe particle system and determining particle system visibility."
    IDC_PARTICLE_LIFETIME   "This value determines the lifetime of an individual particle.  Use \na value of 0 to indicate that particles never die."
    IDC_PARTICLE_POSITION_RANDOM 
                            "This value determines an initial random offset for the position of \na new particle in the system."
    IDC_PARTICLE_VELOCITY   "This value determines the initial velocity of particles as they are \nemitted.  Note that the actual inital particle velocity may be \naffected by the emitter velocity depending on the state of the \n""inherit velocity"" and ""inherit position"" checkboxs."
    IDC_PARTICLE_TWIST_VELOCITY 
                            "This value determines the rate at which the particles in the \nsystem rotate around the Z axis."
    IDC_PARTICLE_SIZE       "This value determines the initial size of particles in the system."
    IDC_PARTICLE_SIZE_VELOCITY 
                            "This value determines the rate of change of the size of particles \nover the lifetime of the particle.  Positive values cause the \nparticles to grow while negative values cause particles to shrink. \nNote that if the ""Update Size Velocity"" checkbox is checked in \nthe Particle Editor, the size velocity will automatically be \ncalculated such that the particle is ""full size"" at birth and ""zero \nsize"" at death (if particles have infinite lifetime, then the emitter \nlifetime is used instead of the particle lifetime)."
    IDC_PARTICLE_SRC_BLEND  "This value determines the source blend factor to use when\nrendering.  Setting the destination blend factor to ZERO and \nthe source blend factor to ONE will disable framebuffer blending."
    IDC_PARTICLE_DST_BLEND  "This value determines the destination blend factor to use when \nrendering.  Setting the destination blend factor to ZERO and the \nsource blend factor to ONE will disable framebuffer blending."
    IDC_PARTICLE_TEXTURE    "This is the name of the texture to use when rendering \nparticles in the system."
    IDC_PARTICLE_TEXTURE_FPS 
                            "This value determines the texture framerate to use when the\nparticle texture is an animated texture.  This value is ignored \nwhen the particle texture is not animated."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDC_CHECK_ACTIVE        "Check this box to actively render this particle system."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDC_DRAW_RADIUS         "Check this box to actively render a point cloud approximation of the bounding radius."
    IDC_EDIT_MIN_RENDER_DIST 
                            "This value determines the minimum distance (in camera space) at which to render this particle system.  At distances less than this value, the particle system is no longer rendered.  If this value is greater than the maximum rendering distance, both values (minimum and maximum) are ignored."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDC_EDIT_MAX_RENDER_DIST 
                            "This value determines the maximum distance (in camera space) at which to render this particle system.  At distances greater than this value, the particle system is no longer rendered.  If this value is less than the minimum rendering distance, both values (minimum and maximum) are ignored."
    IDC_F_INHERIT_POSITION  "Check this box to force the initial particle position and velocity\nto be relative to the emitter."
    IDC_F_INHERIT_VELOCITY  "Check this box to force new particles to inherit the emitter's\nvelocity upon creation."
    IDC_F_IGNORE_ORIENTATION 
                            "Check this box to force the particle system to be\norientation independent."
    IDC_F_RENDER_PARTICLE_LIFETIME 
                            "Check this box to force the particle system to continue to render \nas long as there are particles that are alive.  If this field is left\nunchecked, the particle system will die (and hence not be\nrendered) as soon the emitter lifetime is extinguished."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDC_EDIT_SCALE          "This value determines the scale of the ground plane.  This is used only while in the Particle Editor and the value does not affect the particle system in any way."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDC_F_RENDER_DITHER     "Check this box to enable dithering when rendering."
    IDC_F_RENDER_FOG        "Check this box to enable fog when rendering.  Note that the\nruntime only enables or disables fog, it does NOT set any other\nfog-related state (functions, color, etc...).  "
    IDC_INITIAL_PARTICLE_COUNT 
                            "This value determines the number of particles to create when\nthe particle system is first created."
    IDC_MAX_PARTICLE_COUNT  "This value determines the absolute maximum number of particles \nto create over the lifetime of the particle system.  "
    IDC_EMITTER_LIFETIME    "The emitter lifetime of the system control how the length of time\nthat new particles will be created and emitted.  Use a value of 0 \nto signify that the emitter never dies."
    IDC_EMITTER_FREQUENCY   "The emitter frequency controls how often new particles are\ncreated and emitted into the particle system."
    IDC_EMITTER_DIRECTION_X "The emitter direction (together with the emitter randomizer value\nand the emitter damp) controls the vector along which particles \nare emitted.  "
    IDC_EMITTER_DIRECTION_Y "The emitter direction (together with the emitter randomizer value \nand the emitter damp) controls the vector along which particles \nare emitted.  "
    IDC_EMITTER_DIRECTION_Z "The emitter direction (together with the emitter randomizer value \nand the emitter damp) controls the vector along which particles \nare emitted.  "
    IDC_EMITTER_RANDOM      "The emitter randomizer value is used to determine a random \noffset direction vector that is added to the emitter direction when \nemitting new particles."
    IDC_EMITTER_DAMP_X      "The emitter damp controls how much the emiiter direction is \naffected along a particular axis (X, Y, Z).  The (i, j, k) of the \nemitter damp should normally be between 0.0 and 1.0."
    IDC_EMITTER_DAMP_Y      "The emitter damp controls how much the emiiter direction is \naffected along a particular axis (X, Y, Z).  The (i, j, k) of the \nemitter damp should normally be between 0.0 and 1.0."
    IDC_EMITTER_DAMP_Z      "The emitter damp controls how much the emiiter direction is \naffected along a particular axis (X, Y, Z).  The (i, j, k) of the \nemitter damp should normally be between 0.0 and 1.0."
    IDC_GRAVITY_X           "This value determines the full gravity vector that should be \napplied to each living particle in the particle system.  The gravity \nis applied additively during particle simulation."
    IDC_GRAVITY_Y           "This value determines the full gravity vector that should be \napplied to each living particle in the particle system.  The gravity \nis applied additively during particle simulation.\n"
    IDC_GRAVITY_Z           "This value determines the full gravity vector that should be \napplied to each living particle in the particle system.  The gravity \nis applied additively during particle simulation."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDC_PARTICLE_COLOR_CLEAR_KEY 
                            "Removes the currently selected frame from the list of color key frames."
    IDC_PARTICLE_COLOR_CLEAR_ALL 
                            "Resets the color frames to a constant color."
    IDC_PARTICLE_COLOR_KEY_COLOR 
                            "This is the value of the currently selected color key frame.  Click here to change the color value."
    IDC_PARTICLE_COLOR_KEY_COLOR_GRADIENT 
                            "This shows an approximation of the effect of the current color key frame set."
END

