IDD_EXECUTE_TEST_PROMPT DIALOG DISCARDABLE  0, 0, 224, 183
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "Ok",IDOK,54,162,50,14
    COMBOBOX        IDC_RUN_TEST,7,125,210,100,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    COMBOBOX        IDC_RUN_RETURN,7,141,210,145,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "You can override the execution of the test using the following.",
                    IDC_STATIC,7,115,210,8
    LTEXT           "Static",IDC_TEST_DESCRIPTION,7,5,210,107,SS_SUNKEN
    PUSHBUTTON      "Exit Darth",IDC_EXIT,120,162,50,14
END

IDD_TEST_FAILURE_PROMPT DIALOG DISCARDABLE  0, 0, 213, 95
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Test Failed!"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "You may now choose to retry the test, continue on to the next test, or abort this application completely.",
                    IDC_STATIC,7,39,199,18
    DEFPUSHBUTTON   "&Retry Test",IDC_RETRY,16,74,50,14
    PUSHBUTTON      "&Continue",IDC_CONTINUE,81,74,50,14
    PUSHBUTTON      "&Abort",IDC_ABORT,146,74,50,14
    LTEXT           "The test you just executed did not complete successfully.",
                    IDC_STATIC,7,20,199,8
END

IDD_TEST_EXCEPTION_PROMPT DIALOG DISCARDABLE  0, 0, 420, 194
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Unhandled Exception!"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "&Retry Test",IDC_RETRY,86,173,50,14
    PUSHBUTTON      "&Continue",IDC_CONTINUE,152,173,50,14
    PUSHBUTTON      "&Abort",IDC_ABORT,218,173,50,14
    EDITTEXT        IDC_TRACE_OUTPUT,7,20,406,120,ES_MULTILINE | 
                    ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | 
                    WS_VSCROLL | WS_HSCROLL
    LTEXT           "The test caused an unhandled exception while executing.  The output below may be useful in reproducing this behavior.",
                    IDC_STATIC,7,7,406,8
    LTEXT           "You may now choose to retry the test, continue on to the next test, or abort this application completely.  Note that your system may be in an unstable state.",
                    IDC_STATIC,7,148,406,19
    PUSHBUTTON      "&Debug",IDC_DEBUG,284,173,50,14
END

IDD_LIBRARY_ERROR_PROMPT DIALOGEX 0, 0, 408, 194
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Digital Anvil Library Error"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "&Continue",IDC_CONTINUE,113,173,50,14
    PUSHBUTTON      "&Abort",IDC_ABORT,179,173,50,14
    PUSHBUTTON      "&Debug",IDC_DEBUG,245,173,50,14
    LTEXT           "Some component of the Digital Anvil Libraries has reported the following error.",
                    IDC_STATIC,7,7,394,8
    CTEXT           "You may now choose to continue (ignoring the error), abort this application, or drop into the debugger.",
                    IDC_STATIC,7,158,394,8
    EDITTEXT        IDC_MESSAGE,7,19,394,21,ES_MULTILINE | ES_AUTOVSCROLL | 
                    ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER,
                    WS_EX_STATICEDGE
    EDITTEXT        IDC_TRACE_OUTPUT,7,44,394,108,ES_MULTILINE | 
                    ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | 
                    WS_VSCROLL | WS_HSCROLL
END


