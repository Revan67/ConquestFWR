			</File>
			<File
				RelativePath="..\..\..\Include\IHardPoint.h">
			</File>
			<File
				RelativePath="..\..\..\Include\PersistMath.h">
			</File>
			<File
				RelativePath="..\..\..\Include\Results.h">
			</File>
			<File
				RelativePath="..\..\..\Include\Stddat.h">
			</File>
			<File
				RelativePath="..\..\..\Include\SysConsumerDesc.h">
			</File>
			<File
				RelativePath="..\..\..\Include\TComponent.h">
			</File>
			<File
				RelativePath="..\..\..\Include\TSmartPointer.h">
			</File>
			<File
