			</File>
			<File
				RelativePath="..\..\..\Include\engcomp.h">
			</File>
			<File
				RelativePath="..\..\..\Include\matrix.h">
			</File>
			<File
				RelativePath="..\..\..\Include\model.h">
			</File>
			<File
				RelativePath="..\..\..\Include\quat.h">
			</File>
			<File
				RelativePath="..\..\..\Include\vector.h">
			</File>
			<File
				RelativePath="..\..\..\Include\xform.h">
			</File>
		</Filter>
	</Files>
	<Globals>
