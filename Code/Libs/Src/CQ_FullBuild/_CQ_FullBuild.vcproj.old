<?xml version="1.0" encoding = "Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="_CQ_FullBuild"
	SccProjectName="_CQ_FullBuild"
	SccAuxPath=""
	SccLocalPath="."
	SccProvider="MSSCCI:NXN alienbrain"
	Keyword="MakeFileProj">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Release|Win32"
			OutputDirectory=".\Release"
			IntermediateDirectory=".\Release"
			ConfigurationType="10"
			UseOfMFC="0">
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCMIDLTool"/>
			<Tool
				Name="VCPostBuildEventTool"
				Description="copying dlls"
				CommandLine="copy_release_dlls.bat"/>
			<Tool
				Name="VCPreBuildEventTool"/>
		</Configuration>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory=".\_CQ_FullBuild___Win32_Debug"
			IntermediateDirectory=".\_CQ_FullBuild___Win32_Debug"
			ConfigurationType="10"
			UseOfMFC="0">
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCMIDLTool"/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="copy_debug_dlls.bat"/>
			<Tool
				Name="VCPreBuildEventTool"/>
		</Configuration>
	</Configurations>
	<Files>
		<File
			RelativePath=".\Readme.txt">
		</File>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
