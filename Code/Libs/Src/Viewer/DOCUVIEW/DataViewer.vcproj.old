					<Tool
						Name="VCCLCompilerTool"
						AssemblerOutput="4"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\FERROR.cpp">
			</File>
			<File
				RelativePath=".\FILESTRM.cpp">
			</File>
			<File
