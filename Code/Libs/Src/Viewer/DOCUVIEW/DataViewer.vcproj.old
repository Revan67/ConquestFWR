<?xml version="1.0" encoding = "Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="DataViewer"
	SccProjectName="&quot;$/Libs/Src/DataViewer&quot;, UVCAAAAA"
	SccAuxPath=""
	SccLocalPath="."
	SccProvider="MSSCCI:NXN alienbrain">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="OptimizeForSpeed|Win32"
			OutputDirectory=".\DataViewer___Win32_OptimizeForSpeed"
			IntermediateDirectory=".\DataViewer___Win32_OptimizeForSpeed"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				InlineFunctionExpansion="1"
				OptimizeForProcessor="1"
				PreprocessorDefinitions="_WINDOWS;WIN32;_DEBUG;DA_ERROR_LEVEL=8"
				StringPooling="TRUE"
				RuntimeLibrary="4"
				EnableFunctionLevelLinking="TRUE"
				UsePrecompiledHeader="2"
				PrecompiledHeaderFile=".\DataViewer___Win32_OptimizeForSpeed/DataViewer.pch"
				AssemblerListingLocation=".\DataViewer___Win32_OptimizeForSpeed/"
				ObjectFile=".\DataViewer___Win32_OptimizeForSpeed/"
				ProgramDataBaseFileName=".\DataViewer___Win32_OptimizeForSpeed/"
				BrowseInformation="1"
				WarningLevel="4"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="COMHeap.lib DACOM.lib comctl32.lib"
				OutputFile="../../../ExplicitDLL/DocuView.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="../../../ExplicitDLL/DocuView.pdb"
				GenerateMapFile="TRUE"
				MapFileName=".\DataViewer___Win32_OptimizeForSpeed/DocuView.map"
				SubSystem="2"
				EntryPointSymbol="DllMain"
				ImportLibrary=".\DataViewer___Win32_OptimizeForSpeed/DocuView.lib"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="_DEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName=".\DataViewer___Win32_OptimizeForSpeed/DataViewer.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="_DEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
		</Configuration>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory=".\Debug"
			IntermediateDirectory=".\Debug"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				OptimizeForProcessor="1"
				PreprocessorDefinitions="_WINDOWS;WIN32;_DEBUG;DA_ERROR_LEVEL=8"
				StringPooling="TRUE"
				RuntimeLibrary="4"
				UsePrecompiledHeader="2"
				PrecompiledHeaderFile=".\Debug/DataViewer.pch"
				AssemblerListingLocation=".\Debug/"
				ObjectFile=".\Debug/"
				ProgramDataBaseFileName=".\Debug/"
				BrowseInformation="1"
				WarningLevel="4"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="COMHeap.lib DACOM.lib comctl32.lib"
				OutputFile="Debug\DocuView.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="../../../ExplicitDLL/DocuView.pdb"
				GenerateMapFile="TRUE"
				MapFileName=".\Debug/DocuView.map"
				SubSystem="2"
				EntryPointSymbol="DllMain"
				ImportLibrary=".\Debug/DocuView.lib"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="_DEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName=".\Debug/DataViewer.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="..\..\copy_debug_explicit.bat"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="_DEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory=".\Release"
			IntermediateDirectory=".\Release"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				AdditionalOptions="-QaxW "
				InlineFunctionExpansion="1"
				OptimizeForProcessor="1"
				PreprocessorDefinitions="_WINDOWS;WIN32;NDEBUG;DA_ERROR_LEVEL=1"
				StringPooling="TRUE"
				RuntimeLibrary="4"
				EnableFunctionLevelLinking="TRUE"
				UsePrecompiledHeader="2"
				PrecompiledHeaderFile=".\Release/DataViewer.pch"
				AssemblerListingLocation=".\Release/"
				ObjectFile=".\Release/"
				ProgramDataBaseFileName=".\Release/"
				WarningLevel="4"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="COMHeap.lib DACOM.lib"
				OutputFile="Release\DocuView.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="../../../ExplicitDLL/DocuView.pdb"
				GenerateMapFile="TRUE"
				MapFileName=".\Release/DocuView.map"
				SubSystem="2"
				EntryPointSymbol="DllMain"
				ImportLibrary=".\Release/DocuView.lib"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="NDEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName=".\Release/DataViewer.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="..\..\copy_release_explicit.bat"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="NDEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
		</Configuration>
	</Configurations>
	<Files>
		<Filter
			Name="Header files"
			Filter="h">
			<File
				RelativePath=".\DataView.h">
			</File>
			<File
