/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Campaign\tCtrl+N",       ID_FILE_NEW
        MENUITEM "&Open Campaign\tCtrl+O",      ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "New Scenario",                ID_NEW_SCENARIO
        MENUITEM "Open Scenario",               ID_SCENARIO_OPEN
        MENUITEM "Save Senario",                ID_FILE_SAVESENARIO
        MENUITEM "Save Scenario As Missoin",    ID_FILE_SAVEASMISSION
        MENUITEM SEPARATOR
        MENUITEM "Import String Table...",      ID_FILE_IMPORTSTRINGTABLE
        MENUITEM "Export String Table...",      ID_FILE_EXPORTSTRINGTABLE
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "String Table",                ID_STRING_TABLE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "Mode"
    BEGIN
        MENUITEM "Campaign",                    ID_MODE_CAMPAIGN_VIEW
        MENUITEM "Scenario",                    ID_MODE_SCENARIO_VIEW
        MENUITEM "Sector",                      ID_MODE_SECTOR_VIEW
        MENUITEM "System",                      ID_MODE_SYSTEM_VIEW
    END
    POPUP "Player"
    BEGIN
        MENUITEM "Player One",                  ID_PLAYER_PLAYERONE
        MENUITEM "Player Two",                  ID_PLAYER_PLAYERTWO
        MENUITEM "Player Three",                ID_PLAYER_PLAYERTHREE
        MENUITEM "Player Four",                 ID_PLAYER_PLAYERFOUR
        MENUITEM "Player Five",                 ID_PLAYER_PLAYERFIVE
        MENUITEM "Player Six",                  ID_PLAYER_PLAYERSIX
        MENUITEM "Player Seven",                ID_PLAYER_PLAYERSEVEN
        MENUITEM "Player Eight",                ID_PLAYER_PLAYEREIGHT
    END
    POPUP "Map"
    BEGIN
        MENUITEM "Launch",                      ID_MAP_LAUNCH
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Editor...",            ID_APP_ABOUT
    END
END

