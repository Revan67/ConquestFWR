# ─── Our App build outputs ───────────────────────────────────────────────────
# These are compiled from source by VS2022 and should never be committed.
Code/App/Src/debug/
Code/App/Src/Debug/
Code/App/Src/Release/
Code/App/Src/release/
Code/App/Src/MissionDebug/
Code/App/Src/TrimDebug/
Code/App/Src/ZBatcherDebug/
Code/App/Src/GlobalsDebug/

# ─── Library build intermediates ─────────────────────────────────────────────
# .obj/.map/.pdb etc. produced when rebuilding Libs/Src from source.
# NOTE: Code/Libs/ExplicitDLL/debug/ contains PREBUILT DLLs — keep tracked.
Code/Libs/Src/**/[Dd]ebug/
Code/Libs/Src/**/[Rr]elease/

# ─── VS6 intermediate artefacts in App/Src (pre-VS2022 era) ─────────────────
Code/App/Src/*.opt
Code/App/Src/*.ncb

# ─── VS IDE / IntelliSense state (machine-local, not source) ─────────────────
*.user
*.suo
*.ncb
*.aps
.vs/

# ─── Visual SourceSafe metadata (from original source release; no content value)
vssver.scc
mssccprj.scc

# ─── Generic compiled-object extensions (catch any remaining stray files) ────
# These patterns only apply to files not already covered by directory rules above.
*.obj
*.pch
*.sbr
*.bsc
*.ilk
*.idb
*.recipe
*.tlog
*.FileListAbsolute.txt
*.Build.CppClean.log

# ─── Clean GOG reference install (binary reference copy, not source) ─────────
Conquest Frontier Wars/

# ─── Runtime debug output files generated by running the game ────────────────
startup_log.txt
build_out.txt
build.log
buildmission.bat
buildtrim.bat
buildtrim_rebuild.bat
dobuild.bat
