<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared build properties for all projects in the ConquestFWR tree.
  MSBuild automatically imports this file from any subdirectory.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- DirectX June 2010 SDK - required for d3dx9.h, d3dx9.lib, etc.
         Place AFTER the Windows SDK headers to avoid SAL annotation conflicts. -->
    <DXSDK_IncludeDir>$(MSBuildThisFileDirectory)..\DXSDK\Include</DXSDK_IncludeDir>
    <DXSDK_LibDir_x86>$(MSBuildThisFileDirectory)..\DXSDK\Lib\x86</DXSDK_LibDir_x86>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Compatibility stubs for removed APIs (DirectPlay, etc.) -->
    <Compat_IncludeDir>$(MSBuildThisFileDirectory)Code\Libs\Include\Compat</Compat_IncludeDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Debug auto-deploy remains convenient, but the path can now be overridden
         with /p:ConquestDebugDeployDir=... or by Build-Conquest.ps1. -->
    <ConquestDebugDeployDir Condition="'$(ConquestDebugDeployDir)' == ''">D:\Games\GOG\Conquest Frontier Wars</ConquestDebugDeployDir>
    <ConquestEnableDeploy Condition="'$(ConquestEnableDeploy)' == ''">true</ConquestEnableDeploy>
  </PropertyGroup>

  <PropertyGroup>
    <!-- BSCMAKE browse-info generation is not needed with VS2022 IntelliSense
         and fails when .sbr files are missing after a partial clean. -->
    <GenerateBrowseInformation>false</GenerateBrowseInformation>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Compat stubs first so they shadow missing system headers -->
      <!-- DXSDK after Windows SDK so modern sal.h wins -->
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(Compat_IncludeDir);$(DXSDK_IncludeDir)</AdditionalIncludeDirectories>
      <!-- Disable C++11 thread-safe static init ("magic statics") to work around
           a VS 2022 front-end ICE (toinil.c:899) triggered by non-const static
           local arrays in DACOM_MAP template expansion. Safe for this codebase
           since it is single-threaded during static initialization. -->
      <AdditionalOptions>%(AdditionalOptions) /Zc:threadSafeInit-</AdditionalOptions>
      <!-- Force static release CRT (/MT) across all configurations to match
           Conquest.exe. Mixing /MTd DLLs with the /MT exe causes R6030. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>%(AdditionalLibraryDirectories);$(DXSDK_LibDir_x86);$(MSBuildThisFileDirectory)Code\Libs\Static</AdditionalLibraryDirectories>
      <!-- Legacy prebuilt libs reference old CRT names that no longer ship in VS2022. -->
      <IgnoreSpecificDefaultLibraries>%(IgnoreSpecificDefaultLibraries);libc.lib;libcd.lib</IgnoreSpecificDefaultLibraries>
      <!-- COMHeap.lib replaces CRT heap functions (_msize, malloc, free etc.).
           /FORCE:MULTIPLE lets the linker keep the first definition (COMHeap wins). -->
      <AdditionalOptions>%(AdditionalOptions) /FORCE:MULTIPLE</AdditionalOptions>
      <!-- Legacy prebuilt objects lack SAFESEH records; disable the requirement. -->
      <ImageHasSafeExceptionHandlers>false</ImageHasSafeExceptionHandlers>
    </Link>
    <Lib>
      <AdditionalLibraryDirectories>%(AdditionalLibraryDirectories);$(DXSDK_LibDir_x86)</AdditionalLibraryDirectories>
    </Lib>
  </ItemDefinitionGroup>

</Project>
